<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>st.orm</groupId>
        <artifactId>storm-framework</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>storm-dialect-tck</artifactId>
    <name>Storm Dialect TCK</name>
    <description>The conformance suite every dialect module runs. Build-time only; not published.</description>
    <properties>
        <!-- Test infrastructure for the reactor's dialect modules, of no use to a consumer. The release profile's
             Central publishing plugin ignores maven.deploy.skip and stages every reactor module into the one bundle
             it uploads, so the module also lists itself in that plugin's exclusion list: Central rejects the whole
             bundle over a single unsigned artifact or one without sources and javadoc. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <excludeArtifacts>${project.artifactId}</excludeArtifacts>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <dependency>
            <groupId>st.orm</groupId>
            <artifactId>storm-foundation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>st.orm</groupId>
            <artifactId>storm-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The suite is JUnit test code, so these are compile-scoped here and test-scoped in the dialect
             modules that depend on it. -->
        <dependency>
            <groupId>st.orm</groupId>
            <artifactId>storm-test</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.48</version>
        </dependency>
    </dependencies>
</project>
